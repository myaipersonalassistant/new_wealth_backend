{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "npm install && cd server && npm install",
  "rewrites": [
    {
      "source": "/api/stripe-webhook",
      "destination": "/api/stripe-webhook"
    },
    {
      "source": "/api/blob-upload",
      "destination": "/api/blob-upload"
    },
    {
      "source": "/api/:path*",
      "destination": "/api/catchall?path=:path*"
    }
  ]
}
